NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=5001
MONGODB_URI=mongodb://127.0.0.1:27017/loadout
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=debug

# Unique random secret in production (e.g. openssl rand -base64 48)
JWT_ACCESS_SECRET=replace-this-with-a-32-byte-or-longer-secret

# Groq Cloud AI (Free tier / Fast inference)
# When unset, LOADOUT operates completely offline with local heuristic performance copilot
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_ENDPOINT=https://api.groq.com/openai/v1/chat/completions
